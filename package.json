  "description": "PROJECT WA LIFE — simulation de vie en Afrique de l'Ouest",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
